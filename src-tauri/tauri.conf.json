{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fork Zapret",
  "version": "1.0.0",
  "identifier": "com.w3kiss.forkzapret",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fork Zapret",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#050507"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://avatars.githubusercontent.com https://github.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "W3kiss",
    "copyright": "© W3kiss",
    "category": "Utility",
    "shortDescription": "Fork Zapret",
    "longDescription": "Modern desktop launcher for zapret by Flowseal. Developed by W3kiss.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../Zapret/": "zapret/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": ["Russian", "English", "Ukrainian", "German"]
      }
    }
  }
}
